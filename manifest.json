{
	"manifest_version": 3,
	"name": "FoE Side Tracker",
	"version": "1.0.0",
	"description": "Standalone tracker for Forge of Empires: diamond-producing building count, tracked Great Building levels and bonus building counts. Independent of FoE Helper.",

	"action": {
		"default_icon": {
			"16": "icons/app16.png",
			"48": "icons/app48.png",
			"128": "icons/app128.png"
		},
		"default_title": "FoE Side Tracker"
	},

	"icons": {
		"16": "icons/app16.png",
		"48": "icons/app48.png",
		"128": "icons/app128.png"
	},

	"content_scripts": [
		{
			"matches": ["https://*.forgeofempires.com/*"],
			"include_globs": ["*forgeofempires.com/game*"],
			"js": ["content.js"],
			"run_at": "document_start",
			"world": "MAIN"
		}
	]
}
